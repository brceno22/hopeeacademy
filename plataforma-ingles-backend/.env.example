# Copiar a .env y completar. Nunca commitear .env.

PORT=3003

# --- Moodle ---
MOODLE_URL=https://moodle.example.com
# Shortname del servicio de web services en Moodle (tiene que coincidir).
MOODLE_SERVICE=hopee
# Token del servicio (sólo para operaciones admin; nunca para servir archivos de usuario)
MOODLE_TOKEN=
MOODLE_STUDENT_ROLE_ID=5
MOODLE_TEACHER_ROLE_ID=3

# --- Base de datos ---
DB_HOST=localhost
DB_PORT=5433
DB_USER=postgres
DB_PASS=
DB_NAME=plataforma_ingles
# Dejar en false: el esquema se maneja con migraciones (npm run migration:run)
DB_SYNC=false

# Directorio de medios de exámenes (imágenes / audio). En Docker es un volumen.
UPLOADS_DIR=uploads

# --- Admin ---
# Clave que se escribe en el panel admin. Mínimo 16 caracteres (32+ recomendado).
# No uses valores que contengan "cambia-esta".
ADMIN_SECRET=
# Firma HMAC de la cookie de sesión admin. Mínimo 32 caracteres.
# Generar con: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
ADMIN_SESSION_SECRET=

# --- HTTP ---
# Origenes permitidos por CORS, separados por coma. Vacío bloquea todo origen de navegador.
CORS_ORIGINS=http://localhost:5173
# Hops de reverse proxy para rate limit por IP. false en dev local.
# En Docker (Caddy + nginx) usar 2.
TRUST_PROXY=false

APP_TZ=America/Argentina/Buenos_Aires

# Swagger en /api-docs. Fuera de producción está encendido; en producción
# queda apagado salvo SWAGGER=true.
SWAGGER=
