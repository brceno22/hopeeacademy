# Copiar a .env en la raíz del repo antes de `docker compose up`.
# Nunca commitear el .env real.

# --- TLS (Caddy / Let's Encrypt) ---
# FQDN público con DNS A apuntando a este servidor. Let's Encrypt no firma IPs.
DOMAIN=hopee.example.com
CADDY_EMAIL=admin@example.com

# --- Base de datos ---
DB_HOST=db
DB_PORT=5432
DB_USER=postgres
DB_PASS=
DB_NAME=plataforma_ingles
DB_SYNC=false

# --- Backend ---
PORT=3003
NODE_ENV=production
# 2 hops: Caddy → nginx → Nest
TRUST_PROXY=2
UPLOADS_DIR=uploads

# --- Moodle ---
MOODLE_URL=https://moodle.example.com/webservice/rest/server.php
# Shortname del servicio de web services en Moodle (tiene que coincidir).
MOODLE_SERVICE=hopee
MOODLE_TOKEN=
MOODLE_STUDENT_ROLE_ID=5
MOODLE_TEACHER_ROLE_ID=3

# --- Admin (mínimo 32 caracteres cada uno; no uses "cambia-esta") ---
# node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
ADMIN_SECRET=
ADMIN_SESSION_SECRET=

# Caddy + nginx hacen same-origin; CORS puede quedar vacío.
CORS_ORIGINS=

APP_TZ=America/Argentina/Buenos_Aires
